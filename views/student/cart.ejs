<% const sidebar = '../partials/sidebar-student'; %>
<% const activePath = '/cart'; %>
<% const pageTitle = 'Cart'; %>
<% const pageSubtitle = 'Review items and proceed to checkout.'; %>
<%- include('../partials/app-start', { title, sidebar, activePath, pageTitle, pageSubtitle }) %>

<div class="space-y-3">
  <% items.forEach(item => { %>
    <div class="rounded-2xl border border-slate-200/60 bg-white p-4 flex items-center justify-between gap-4">
      <div class="min-w-0">
        <p class="font-semibold truncate"><%= item.title %></p>
        <p class="text-sm text-slate-500"><%= item.category || 'General' %></p>
      </div>
      <div class="flex items-center gap-3">
        <span class="font-extrabold text-indigo-700">₹<%= item.price %></span>
        <a href="/orders/checkout/<%= item._id %>" class="px-4 py-2 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700">Checkout</a>
      </div>
    </div>
  <% }) %>

  <% if (!items.length) { %>
    <div class="rounded-2xl border border-slate-200/60 bg-white p-6 text-sm text-slate-600">
      Your cart is empty. <a href="/courses" class="font-semibold text-indigo-700 hover:underline">Browse courses</a>.
    </div>
  <% } %>
</div>

<%- include('../partials/app-end', { sidebar }) %>
