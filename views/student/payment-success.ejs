<% const sidebar = '../partials/sidebar-student'; %>
<% const activePath = '/my-courses'; %>
<% const pageTitle = 'Payment successful'; %>
<% const pageSubtitle = 'Your course is now unlocked.'; %>
<%- include('../partials/app-start', { title, sidebar, activePath, pageTitle, pageSubtitle }) %>

<div class="tm-card p-6 text-center">
  <div class="mx-auto w-14 h-14 rounded-2xl bg-emerald-50 border border-emerald-200/60 flex items-center justify-center">
    <span class="text-emerald-700 font-extrabold text-xl">✓</span>
  </div>
  <h2 class="text-xl font-extrabold mt-4">Thank you!</h2>
  <p class="text-sm text-slate-600 mt-1">Course unlocked: <span class="font-semibold"><%= order.course.title %></span></p>
  <p class="text-xs text-slate-500 mt-3">Transaction: <%= order.merchantTransactionId %></p>
  <div class="mt-6 flex flex-col sm:flex-row gap-2 justify-center">
    <a href="/learn/<%= order.course._id %>" class="tm-btn tm-btn-primary" style="padding:12px 16px;">Start learning</a>
    <a href="/my-courses" class="tm-btn tm-btn-ghost" style="padding:12px 16px;">Go to My Courses</a>
  </div>
</div>

<%- include('../partials/app-end', { sidebar }) %>
