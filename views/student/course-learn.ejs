<% const sidebar = '../partials/sidebar-student'; %>
<% const activePath = '/my-courses'; %>
<% const pageTitle = course.title; %>
<% const pageSubtitle = 'Watch lectures, track progress, and complete the quiz.'; %>
<%- include('../partials/app-start', { title, sidebar, activePath, pageTitle, pageSubtitle }) %>

<% const firstLecture = course.topics[0]?.lectures[0]; %>
<div class="grid lg:grid-cols-12 gap-5">
  <aside class="lg:col-span-4 tm-card-flat p-4 bg-slate-50">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs uppercase tracking-wide text-slate-500 font-bold">Progress</p>
        <p class="text-2xl font-extrabold mt-1"><%= progress ? progress.percentage : 0 %>%</p>
      </div>
      <div class="h-2 w-28 bg-white rounded-full overflow-hidden border border-slate-200/60">
        <div class="h-full bg-indigo-600" style="width:<%= progress ? progress.percentage : 0 %>%"></div>
      </div>
    </div>
    <div class="flex items-center gap-2 mt-4">
      <a href="/learn/<%= course._id %>/certificate" class="tm-btn tm-btn-ghost">Certificate</a>
      <a href="/learn/<%= course._id %>/quiz" class="tm-btn tm-btn-primary">Take Quiz</a>
    </div>

    <div class="mt-5 space-y-4">
      <% course.topics.forEach(topic => { %>
        <div class="bg-white rounded-2xl border border-slate-200/60 p-3">
          <p class="font-extrabold text-slate-900 text-sm mb-2"><%= topic.title %></p>
          <ul class="space-y-1">
            <% topic.lectures.forEach(lecture => { %>
              <li class="flex items-center justify-between gap-2">
                <button
                  type="button"
                  class="lecture-link text-left flex-1 text-sm text-slate-700 hover:text-indigo-700 font-semibold"
                  data-video="<%= lecture.videoUrl %>"
                  data-title="<%= lecture.title.replace(/\"/g,'&quot;') %>"
                >
                  <%= lecture.title %>
                </button>
                <button data-lecture="<%= lecture._id %>" class="mark-complete tm-btn tm-btn-ghost" style="padding:6px 10px;font-size:12px;">Mark</button>
              </li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>
  </aside>

  <section class="lg:col-span-8 tm-card overflow-hidden">
    <div class="aspect-video bg-slate-950">
      <% if (firstLecture) { %>
        <iframe id="player" src="<%= firstLecture.videoUrl %>" class="w-full h-full" allowfullscreen></iframe>
      <% } else { %>
        <div class="h-full flex items-center justify-center text-white">No lectures yet.</div>
      <% } %>
    </div>
    <div class="p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-wide text-slate-500 font-bold">Now playing</p>
          <p class="text-base font-extrabold mt-1" id="nowPlaying"><%= firstLecture ? firstLecture.title : '—' %></p>
        </div>
        <span class="tm-badge"><%= course.category || 'General' %></span>
      </div>
      <p class="text-sm text-slate-600 mt-3"><%= course.description %></p>
    </div>
  </section>
</div>

<%- include('../partials/app-end', { sidebar }) %>
<script>
  const player = document.getElementById('player');
  const nowPlaying = document.getElementById('nowPlaying');
  document.querySelectorAll('.lecture-link').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!player) return;
      player.src = btn.dataset.video;
      if (nowPlaying) nowPlaying.innerText = btn.dataset.title || 'Lecture';
    });
  });

  document.querySelectorAll('.mark-complete').forEach(btn => {
    btn.addEventListener('click', async () => {
      const res = await fetch('/learn/<%= course._id %>/progress', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lectureId: btn.dataset.lecture })
      });
      const data = await res.json();
      btn.innerText = 'Done';
      btn.classList.add('text-slate-400');
    });
  });
</script>
