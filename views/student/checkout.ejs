<% const sidebar = '../partials/sidebar-student'; %>
<% const activePath = '/cart'; %>
<% const pageTitle = 'Checkout'; %>
<% const pageSubtitle = 'Confirm your order and pay securely via PhonePe.'; %>
<%- include('../partials/app-start', { title, sidebar, activePath, pageTitle, pageSubtitle }) %>

<div class="tm-card p-6">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="text-xs uppercase tracking-wide text-slate-500 font-bold">Course</p>
      <p class="text-lg font-extrabold truncate mt-1"><%= course.title %></p>
      <p class="text-sm text-slate-500 mt-1"><%= course.category || 'General' %></p>
    </div>
    <div class="text-right">
      <p class="text-xs uppercase tracking-wide text-slate-500 font-bold">Total</p>
      <p class="text-2xl font-extrabold text-indigo-700 mt-1">$<%= course.price %></p>
    </div>
  </div>

  <div class="mt-5 tm-card-flat p-4 bg-slate-50">
    <p class="text-sm text-slate-700 font-semibold">You’ll be redirected to PhonePe to complete payment.</p>
    <p class="text-sm text-slate-500 mt-1">After payment, the course will be added to your account automatically.</p>
  </div>

  <form method="post" action="/orders/checkout/<%= course._id %>" class="mt-5">
    <button class="w-full tm-btn tm-btn-primary" style="padding:14px 16px;font-size:15px;">Pay with PhonePe</button>
  </form>
</div>

<%- include('../partials/app-end', { sidebar }) %>
