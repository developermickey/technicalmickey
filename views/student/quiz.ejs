<%- include('../partials/head', { title }) %>
<body class="bg-slate-50">
<%- include('../partials/navbar') %>
<% const sidebar = '../partials/sidebar-student'; %>
<% const activePath = '/my-courses'; %>
<% const pageTitle = 'Quiz'; %>
<% const pageSubtitle = course.title; %>
<%- include('../partials/app-start', { title, sidebar, activePath, pageTitle, pageSubtitle }) %>

<div class="tm-card p-6">
  <% if (!course.quiz) { %>
    <p class="text-sm text-slate-600">Quiz coming soon.</p>
  <% } else { %>
    <form id="quiz-form" class="space-y-3">
      <% course.quiz.questions.forEach((q, idx) => { %>
        <div class="tm-card-flat p-4 bg-slate-50">
          <p class="font-extrabold text-slate-900 mb-3 text-sm"><%= (idx + 1) %>. <%= q.question %></p>
          <div class="space-y-2">
            <% q.options.forEach((opt, oIdx) => { %>
              <label class="flex items-center gap-2 text-sm text-slate-700 font-semibold">
                <input type="radio" name="q<%= idx %>" value="<%= oIdx %>">
                <span><%= opt %></span>
              </label>
            <% }) %>
          </div>
        </div>
      <% }) %>
      <button class="tm-btn tm-btn-primary" style="padding:12px 16px;">Submit</button>
    </form>
    <div id="result" class="mt-4 text-sm text-slate-700 font-semibold"></div>
  <% } %>
</div>

<%- include('../partials/app-end', { sidebar }) %>
<script>
  const form = document.getElementById('quiz-form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const answers = [];
      const questions = form.querySelectorAll('[name^="q"]');
      const count = new Set(Array.from(questions).map(i => i.name)).size;
      for (let i = 0; i < count; i++) {
        const selected = form.querySelector(`input[name="q${i}"]:checked`);
        answers.push(selected ? Number(selected.value) : -1);
      }
      const res = await fetch('/learn/<%= course._id %>/quiz', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ answers })
      });
      const data = await res.json();
      document.getElementById('result').innerText = `Score: ${data.score}/${data.total} - ${data.passed ? 'Passed' : 'Try again'}`;
    });
  }
</script>
