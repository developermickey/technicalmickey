<%- include('partials/head', { title }) %>
<body class="bg-slate-50">
<%- include('partials/navbar') %>
<main class="max-w-7xl mx-auto px-4 lg:px-6 py-10 grid lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 bg-white border border-slate-200/60 rounded-2xl shadow-sm p-6">
    <p class="text-xs uppercase tracking-wide text-indigo-700 font-bold mb-2"><%= course.category || 'General' %></p>
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 mb-4"><%= course.title %></h1>
    <p class="text-slate-700 mb-6"><%= course.description %></p>
    <h3 class="text-xl font-semibold text-slate-900 mb-3">Topics</h3>
    <div class="space-y-3">
      <% course.topics.forEach(topic => { %>
        <div class="border border-slate-200/60 rounded-2xl p-4 bg-slate-50">
          <div class="font-bold text-slate-900 mb-2"><%= topic.title %></div>
          <ul class="space-y-1 text-sm text-slate-600">
            <% topic.lectures.forEach(lecture => { %>
              <li>• <%= lecture.title %> <span class="text-slate-400">(<%= lecture.duration || 'N/A' %>)</span></li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>
  </div>
  <div class="bg-white border border-slate-200/60 rounded-2xl shadow-sm p-6 h-fit">
    <img src="<%= course.thumbnail || 'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=800&q=60' %>" class="rounded-2xl h-44 w-full object-cover mb-4" />
    <div class="flex items-center justify-between mb-2">
      <span class="text-slate-500 text-sm">Price</span>
      <span class="text-2xl font-extrabold text-indigo-700">₹<%= course.price %></span>
    </div>
    <form method="post" action="/courses/<%= course._id %>/cart" class="space-y-3">
      <button class="w-full py-3 bg-indigo-600 text-white rounded-xl font-semibold hover:bg-indigo-700">Add to cart</button>
    </form>
    <div class="text-sm text-slate-600 mt-4">
      <p>Includes video lectures, quizzes, and completion certificate.</p>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
