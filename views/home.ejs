<%- include('partials/head', { title }) %>

  <body class="bg-slate-950">
    <%- include('partials/navbar') %>

      <!-- Hero Section with Animated Background -->
      <section class="relative min-h-screen flex items-center overflow-hidden">
        <!-- Animated Grid Background -->
        <div class="absolute inset-0 bg-slate-950">
          <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/10 via-purple-500/5 to-pink-500/10"></div>
          <div class="grid-pattern absolute inset-0 opacity-20"></div>
          <div class="floating-orb orb-1"></div>
          <div class="floating-orb orb-2"></div>
          <div class="floating-orb orb-3"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 lg:px-6 py-20">
          <div class="grid lg:grid-cols-2 gap-16 items-center">

            <!-- Left: Content -->
            <div class="space-y-8 fade-in-up">
              <div
                class="inline-flex items-center gap-3 px-5 py-2 bg-white/5 backdrop-blur-xl border border-white/10 rounded-full">
                <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                <span class="text-sm font-semibold text-white">Join 50,000+ Students Worldwide</span>
              </div>

              <h1 class="text-6xl md:text-7xl lg:text-8xl font-black text-white leading-none tracking-tight">
                Master Skills
                <span
                  class="block text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 animate-gradient">
                  That Matter
                </span>
              </h1>

              <p class="text-xl md:text-2xl text-slate-300 leading-relaxed max-w-xl font-light">
                Transform your career with industry-recognized courses taught by world-class experts. Start learning
                today.
              </p>

              <div class="flex flex-wrap gap-4">
                <a href="/courses"
                  class="group relative px-8 py-4 bg-white text-slate-950 rounded-2xl font-bold text-lg overflow-hidden hover:scale-105 transition-transform duration-300">
                  <span class="relative z-10 flex items-center gap-2">
                    Start Learning Free
                    <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none"
                      stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                        d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </span>
                  <div
                    class="absolute inset-0 bg-gradient-to-r from-indigo-500 to-purple-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  </div>
                </a>

                <a href="#featured"
                  class="px-8 py-4 bg-white/5 backdrop-blur-xl border border-white/10 text-white rounded-2xl font-bold text-lg hover:bg-white/10 transition-all duration-300">
                  Explore Courses
                </a>
              </div>

              <!-- Stats -->
              <div class="grid grid-cols-3 gap-6 pt-8">
                <div class="space-y-1">
                  <div class="text-3xl font-black text-white">500+</div>
                  <div class="text-sm text-slate-400 uppercase tracking-wider">Courses</div>
                </div>
                <div class="space-y-1">
                  <div class="text-3xl font-black text-white">200+</div>
                  <div class="text-sm text-slate-400 uppercase tracking-wider">Experts</div>
                </div>
                <div class="space-y-1">
                  <div class="text-3xl font-black text-white">98%</div>
                  <div class="text-sm text-slate-400 uppercase tracking-wider">Success</div>
                </div>
              </div>
            </div>

            <!-- Right: Interactive Course Preview -->
            <div class="relative fade-in-up animation-delay-300">
              <div
                class="glass-card p-8 rounded-3xl backdrop-blur-2xl bg-white/5 border border-white/10 shadow-2xl hover:shadow-indigo-500/20 transition-all duration-500">
                <div class="flex items-center justify-between mb-6">
                  <h3 class="text-xl font-bold text-white">🔥 Trending Now</h3>
                  <span
                    class="px-3 py-1 bg-gradient-to-r from-indigo-500 to-purple-500 text-white rounded-full text-xs font-bold uppercase">Hot</span>
                </div>

                <div class="space-y-4">
                  <% courses.slice(0, 3).forEach((course, index)=> { %>
                    <a href="/courses/<%= course._id %>"
                      class="group block p-4 bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl hover:bg-white/10 hover:border-indigo-500/50 transition-all duration-300"
                      style="animation-delay: <%= 400 + (index * 100) %>ms">
                      <div class="flex gap-4 items-start">
                        <div class="relative flex-shrink-0">
                          <img
                            src="<%= course.thumbnail || 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=200&q=60' %>"
                            class="w-20 h-20 rounded-xl object-cover ring-2 ring-white/10 group-hover:ring-indigo-500/50 transition-all"
                            alt="<%= course.title %>" />
                          <div
                            class="absolute -top-2 -right-2 w-7 h-7 bg-gradient-to-br from-indigo-500 to-purple-500 text-white rounded-full flex items-center justify-center text-xs font-black shadow-lg">
                            <%= index + 1 %>
                          </div>
                        </div>
                        <div class="flex-1 min-w-0">
                          <p class="font-bold text-white mb-1 group-hover:text-indigo-400 transition-colors truncate">
                            <%= course.title %>
                          </p>
                          <p class="text-xs text-slate-400 uppercase tracking-wider mb-2">
                            <%= course.category || 'General' %>
                          </p>
                          <div class="flex items-center gap-3">
                            <span
                              class="text-xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-400">₹
                              <%= course.price %></span>
                            <div class="flex items-center gap-1 text-xs text-slate-400">
                              <svg class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
                                <path
                                  d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                              </svg>
                              <span class="font-semibold">4.9</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </a>
                    <% }) %>
                </div>

                <a href="/courses"
                  class="block mt-6 text-center py-3 text-white font-bold hover:text-indigo-400 transition-colors">
                  View All Courses →
                </a>
              </div>

              <!-- Floating Badge -->
              <div
                class="absolute -bottom-6 -right-6 px-6 py-4 bg-gradient-to-br from-green-500 to-emerald-500 rounded-2xl shadow-2xl shadow-green-500/50 rotate-3 hover:rotate-0 transition-transform duration-300">
                <div class="text-sm text-white/80 uppercase tracking-wider font-semibold">New Students</div>
                <div class="text-3xl font-black text-white">+2,341</div>
                <div class="text-xs text-white/80">This month</div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- Categories Showcase -->
      <section class="relative py-32 bg-white" id="featured">
        <div class="max-w-7xl mx-auto px-4 lg:px-6">
          <div class="text-center mb-16 fade-in-up">
            <div
              class="inline-block px-4 py-2 bg-indigo-100 text-indigo-700 rounded-full text-sm font-bold uppercase mb-4 tracking-wider">
              Explore Categories
            </div>
            <h2 class="text-5xl md:text-6xl font-black text-slate-900 mb-4">
              Find Your Path
            </h2>
            <p class="text-xl text-slate-600 max-w-2xl mx-auto">
              Choose from our curated collection of high-impact learning tracks
            </p>
          </div>

          <!-- Category Cards with Bento Grid Layout -->
          <div class="grid grid-cols-12 gap-4">
            <% const categoryData=[ { name: 'Web Development' , icon: '💻' , color: 'from-blue-500 to-cyan-500' ,
              size: 'col-span-12 md:col-span-6 lg:col-span-4' }, { name: 'Data Science' , icon: '📊' ,
              color: 'from-purple-500 to-pink-500' , size: 'col-span-12 md:col-span-6 lg:col-span-4' }, {
              name: 'Mobile Development' , icon: '📱' , color: 'from-green-500 to-emerald-500' ,
              size: 'col-span-12 md:col-span-6 lg:col-span-4' }, { name: 'Design' , icon: '🎨' ,
              color: 'from-orange-500 to-red-500' , size: 'col-span-12 md:col-span-6 lg:col-span-6' }, {
              name: 'Marketing' , icon: '📈' , color: 'from-cyan-500 to-blue-500' ,
              size: 'col-span-12 md:col-span-6 lg:col-span-6' }, { name: 'Business' , icon: '💼' ,
              color: 'from-pink-500 to-rose-500' , size: 'col-span-12 md:col-span-4 lg:col-span-4' }, {
              name: 'Photography' , icon: '📷' , color: 'from-yellow-500 to-orange-500' ,
              size: 'col-span-12 md:col-span-4 lg:col-span-4' }, { name: 'Music' , icon: '🎵' ,
              color: 'from-indigo-500 to-purple-500' , size: 'col-span-12 md:col-span-4 lg:col-span-4' } ];
              categories.forEach((cat, index)=> {
              const data = categoryData.find(d => d.name === cat) || categoryData[index % categoryData.length];
              %>
              <a href="/courses?category=<%= cat %>"
                class="<%= data.size %> group relative overflow-hidden rounded-3xl bg-gradient-to-br <%= data.color %> p-8 hover:scale-105 transition-all duration-500 shadow-xl hover:shadow-2xl fade-in-up"
                style="animation-delay: <%= index * 100 %>ms">
                <div class="relative z-10">
                  <div class="text-6xl mb-4 group-hover:scale-110 transition-transform duration-300">
                    <%= data.icon %>
                  </div>
                  <h3 class="text-2xl font-black text-white mb-2">
                    <%= cat %>
                  </h3>
                  <p class="text-white/80 font-medium">Explore <%= Math.floor(Math.random() * 50) + 20 %>+ courses</p>
                </div>
                <div
                  class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                </div>
                <div
                  class="absolute bottom-4 right-4 text-white/20 text-8xl font-black opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  →</div>
              </a>
              <% }); %>
          </div>
        </div>
      </section>

      <!-- Featured Courses with Magazine Layout -->
      <section class="relative py-32 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 lg:px-6">
          <div class="flex items-end justify-between mb-12 fade-in-up">
            <div>
              <div
                class="inline-block px-4 py-2 bg-slate-900 text-white rounded-full text-sm font-bold uppercase mb-4 tracking-wider">
                Featured
              </div>
              <h2 class="text-5xl md:text-6xl font-black text-slate-900">
                Popular Courses
              </h2>
            </div>
            <a href="/courses"
              class="hidden md:flex items-center gap-2 px-6 py-3 bg-slate-900 text-white rounded-2xl font-bold hover:bg-slate-800 transition-colors">
              <span>View All</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% courses.forEach((course, index)=> { %>
              <article
                class="group bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 fade-in-up"
                style="animation-delay: <%= index * 100 %>ms">
                <div class="relative overflow-hidden aspect-video">
                  <img
                    src="<%= course.thumbnail || 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=800&q=60' %>"
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                    alt="<%= course.title %>" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                  <div class="absolute top-4 left-4">
                    <span
                      class="px-3 py-1 bg-white/90 backdrop-blur-sm text-slate-900 rounded-full text-xs font-black uppercase tracking-wider">
                      <%= course.category || 'General' %>
                    </span>
                  </div>
                  <div class="absolute bottom-4 right-4">
                    <button
                      class="w-12 h-12 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-white transition-colors group/btn">
                      <svg class="w-5 h-5 text-slate-900 group-hover/btn:scale-110 transition-transform" fill="none"
                        stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                      </svg>
                    </button>
                  </div>
                </div>

                <div class="p-6">
                  <h3
                    class="text-2xl font-black text-slate-900 mb-3 line-clamp-2 group-hover:text-indigo-600 transition-colors">
                    <%= course.title %>
                  </h3>
                  <p class="text-slate-600 mb-4 line-clamp-2 leading-relaxed">
                    <%= course.description %>
                  </p>

                  <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                    <div class="flex items-center gap-4">
                      <div class="flex items-center gap-1">
                        <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                          <path
                            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                        <span class="font-bold text-slate-900">4.8</span>
                      </div>
                      <span class="text-sm text-slate-500">•</span>
                      <span class="text-sm text-slate-500">8h 42m</span>
                    </div>
                    <div
                      class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">
                      ₹<%= course.price %>
                    </div>
                  </div>

                  <a href="/courses/<%= course._id %>"
                    class="block mt-4 py-3 bg-slate-900 text-white text-center rounded-xl font-bold hover:bg-slate-800 transition-colors">
                    Enroll Now
                  </a>
                </div>
              </article>
              <% }); %>
          </div>
        </div>
      </section>

      <!-- Why Choose Us - Split Layout -->
      <section class="relative py-32 bg-slate-900 overflow-hidden">
        <div class="absolute inset-0 opacity-5">
          <div class="absolute inset-0"
            style="background-image: repeating-linear-gradient(45deg, transparent, transparent 35px, rgba(255,255,255,.05) 35px, rgba(255,255,255,.05) 70px);">
          </div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 lg:px-6">
          <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div class="fade-in-up">
              <div
                class="inline-block px-4 py-2 bg-white/10 text-white rounded-full text-sm font-bold uppercase mb-6 tracking-wider">
                Why TechMickey
              </div>
              <h2 class="text-5xl md:text-6xl font-black text-white mb-6 leading-tight">
                Learn From The Best, Become The Best
              </h2>
              <p class="text-xl text-slate-300 leading-relaxed mb-8">
                We're not just another online course platform. We're your partner in building a successful career with
                cutting-edge skills.
              </p>

              <div class="space-y-6">
                <div
                  class="flex gap-4 items-start p-6 bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl hover:bg-white/10 transition-all duration-300">
                  <div
                    class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-purple-500 rounded-xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-white mb-2">Industry Recognized Certificates</h3>
                    <p class="text-slate-400">Add credentials to your resume that employers actually care about</p>
                  </div>
                </div>

                <div
                  class="flex gap-4 items-start p-6 bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl hover:bg-white/10 transition-all duration-300">
                  <div
                    class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-500 rounded-xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-white mb-2">Lifetime Access</h3>
                    <p class="text-slate-400">Learn at your own pace with unlimited access to all course materials</p>
                  </div>
                </div>

                <div
                  class="flex gap-4 items-start p-6 bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl hover:bg-white/10 transition-all duration-300">
                  <div
                    class="w-12 h-12 bg-gradient-to-br from-orange-500 to-red-500 rounded-xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-white mb-2">Expert Instructors</h3>
                    <p class="text-slate-400">Learn from professionals working at top tech companies worldwide</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="relative fade-in-up animation-delay-300">
              <div class="grid grid-cols-2 gap-4">
                <div class="space-y-4">
                  <div
                    class="p-8 bg-gradient-to-br from-indigo-500 to-purple-500 rounded-3xl shadow-2xl transform hover:scale-105 transition-transform duration-300">
                    <div class="text-5xl font-black text-white mb-2">50K+</div>
                    <div class="text-white/80 font-semibold">Active Students</div>
                  </div>
                  <div
                    class="p-8 bg-white rounded-3xl shadow-2xl transform hover:scale-105 transition-transform duration-300">
                    <div class="text-5xl font-black text-slate-900 mb-2">98%</div>
                    <div class="text-slate-600 font-semibold">Success Rate</div>
                  </div>
                </div>
                <div class="space-y-4 pt-8">
                  <div
                    class="p-8 bg-white rounded-3xl shadow-2xl transform hover:scale-105 transition-transform duration-300">
                    <div class="text-5xl font-black text-slate-900 mb-2">200+</div>
                    <div class="text-slate-600 font-semibold">Expert Teachers</div>
                  </div>
                  <div
                    class="p-8 bg-gradient-to-br from-green-500 to-emerald-500 rounded-3xl shadow-2xl transform hover:scale-105 transition-transform duration-300">
                    <div class="text-5xl font-black text-white mb-2">500+</div>
                    <div class="text-white/80 font-semibold">Quality Courses</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Testimonials - Minimal Approach -->
      <section class="relative py-32 bg-white">
        <div class="max-w-7xl mx-auto px-4 lg:px-6">
          <div class="text-center mb-16 fade-in-up">
            <div
              class="inline-block px-4 py-2 bg-slate-900 text-white rounded-full text-sm font-bold uppercase mb-4 tracking-wider">
              Success Stories
            </div>
            <h2 class="text-5xl md:text-6xl font-black text-slate-900 mb-4">
              Loved By Thousands
            </h2>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            <div class="group p-8 bg-slate-50 rounded-3xl hover:bg-slate-100 transition-all duration-300 fade-in-up">
              <div class="flex items-center gap-1 mb-6">
                <% for(let i=0; i < 5; i++) { %>
                  <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                    <path
                      d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  <% } %>
              </div>
              <p class="text-lg text-slate-700 mb-6 leading-relaxed font-medium">
                "TechMickey transformed my career. Within 3 months of completing the Web Development course, I landed my
                dream job!"
              </p>
              <div class="flex items-center gap-4">
                <img src="https://i.pravatar.cc/100?img=12" alt="Student"
                  class="w-14 h-14 rounded-full ring-4 ring-slate-200" />
                <div>
                  <div class="font-black text-slate-900">Priya Sharma</div>
                  <div class="text-sm text-slate-600">Full Stack Developer</div>
                </div>
              </div>
            </div>

