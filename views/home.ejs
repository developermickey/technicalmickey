<%- include('partials/head', { title }) %>
<body class="bg-slate-50">
<%- include('partials/navbar') %>
<header class="max-w-7xl mx-auto px-4 lg:px-6 py-10 md:py-14 grid md:grid-cols-2 gap-8 items-center">
  <div>
    <p class="text-sm font-semibold text-indigo-600 uppercase mb-2">Learn. Build. Grow.</p>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-4">Launch your career with industry-ready courses.</h1>
    <p class="text-lg text-slate-600 mb-6">High-quality video lectures, quizzes, certificates, and a modern learning experience.</p>
    <div class="flex flex-wrap gap-3">
      <a href="/courses" class="px-5 py-3 bg-indigo-600 text-white rounded-xl shadow-sm hover:bg-indigo-700 font-semibold">Browse Courses</a>
      <a href="/about" class="px-5 py-3 bg-white text-slate-900 rounded-xl border border-slate-200 hover:bg-slate-50 font-semibold">Learn more</a>
    </div>
  </div>
  <div class="bg-white border border-slate-200/60 rounded-2xl shadow-sm p-6">
    <h3 class="text-lg font-semibold mb-3">Featured Courses</h3>
    <div class="grid grid-cols-1 gap-3">
      <% courses.forEach(course => { %>
        <a href="/courses/<%= course._id %>" class="block p-3 border border-slate-200/60 rounded-xl hover:border-indigo-200 hover:bg-indigo-50/40">
          <div class="flex justify-between items-center">
            <div>
              <p class="font-semibold text-slate-900"><%= course.title %></p>
              <p class="text-sm text-slate-500"><%= course.category || 'General' %></p>
            </div>
            <span class="text-indigo-700 font-extrabold">₹<%= course.price %></span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</header>

<section class="max-w-7xl mx-auto px-4 lg:px-6 pb-10 md:pb-16">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-2xl font-bold text-slate-900">Categories</h2>
  </div>
  <div class="flex flex-wrap gap-3">
    <% categories.forEach(cat => { %>
      <span class="px-4 py-2 bg-white border border-slate-200/60 rounded-full text-sm font-semibold text-slate-700"><%= cat || 'General' %></span>
    <% }) %>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 lg:px-6 pb-10 md:pb-16">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-2xl font-bold text-slate-900">Popular Courses</h2>
    <a href="/courses" class="text-indigo-600 font-semibold text-sm">See all</a>
  </div>
  <div class="grid md:grid-cols-3 gap-6">
    <% courses.forEach(course => { %>
      <div class="group bg-white border border-slate-200/60 rounded-2xl shadow-sm hover:shadow-md transition overflow-hidden">
        <img src="<%= course.thumbnail || 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=800&q=60' %>" class="rounded-lg h-40 w-full object-cover mb-3" />
        <div class="p-4">
          <p class="text-xs uppercase tracking-wide text-indigo-700 font-bold mb-1"><%= course.category || 'General' %></p>
          <h3 class="text-base font-extrabold tracking-tight text-slate-900 mb-2"><%= course.title %></h3>
          <p class="text-sm text-slate-600 line-clamp-2 mb-4"><%= course.description %></p>
          <div class="flex items-center justify-between">
            <span class="text-indigo-700 font-extrabold">₹<%= course.price %></span>
            <a href="/courses/<%= course._id %>" class="text-sm text-white bg-indigo-600 px-4 py-2 rounded-xl font-semibold hover:bg-indigo-700">View</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
