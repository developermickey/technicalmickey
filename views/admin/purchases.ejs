<% const sidebar = '../partials/sidebar-admin'; %>
<% const activePath = '/admin/purchases'; %>
<% const pageTitle = 'Purchases'; %>
<% const pageSubtitle = 'All paid orders and transaction history.'; %>
<%- include('../partials/app-start', { title, sidebar, activePath, pageTitle, pageSubtitle }) %>

<div class="overflow-hidden rounded-2xl border border-slate-200/60 bg-white">
  <table class="min-w-full divide-y divide-slate-100 text-sm">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs uppercase tracking-wide text-slate-500">Student</th>
        <th class="px-4 py-3 text-left text-xs uppercase tracking-wide text-slate-500">Course</th>
        <th class="px-4 py-3 text-left text-xs uppercase tracking-wide text-slate-500">Amount</th>
        <th class="px-4 py-3 text-left text-xs uppercase tracking-wide text-slate-500">Status</th>
        <th class="px-4 py-3 text-left text-xs uppercase tracking-wide text-slate-500">Date</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% purchases.forEach(p => { %>
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-3 font-semibold"><%= p.user?.email %></td>
          <td class="px-4 py-3 text-slate-700"><%= p.course?.title %></td>
          <td class="px-4 py-3 font-bold text-indigo-700">$<%= p.amount %></td>
          <td class="px-4 py-3">
            <span class="inline-flex px-2 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700"><%= p.status %></span>
          </td>
          <td class="px-4 py-3 text-slate-500"><%= p.createdAt.toDateString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/app-end', { sidebar }) %>
