<% const sidebar = '../partials/sidebar-admin'; %>
<% const activePath = '/admin/users'; %>
<% const pageTitle = 'Users'; %>
<% const pageSubtitle = 'View all registered users and roles.'; %>
<%- include('../partials/app-start', { title, sidebar, activePath, pageTitle, pageSubtitle }) %>

<div class="overflow-hidden rounded-2xl border border-slate-200/60 bg-white">
  <table class="min-w-full divide-y divide-slate-100 text-sm">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs uppercase tracking-wide text-slate-500">Name</th>
        <th class="px-4 py-3 text-left text-xs uppercase tracking-wide text-slate-500">Email</th>
        <th class="px-4 py-3 text-left text-xs uppercase tracking-wide text-slate-500">Role</th>
        <th class="px-4 py-3 text-left text-xs uppercase tracking-wide text-slate-500">Joined</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% users.forEach(u => { %>
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-3 font-semibold"><%= u.name %></td>
          <td class="px-4 py-3 text-slate-600"><%= u.email %></td>
          <td class="px-4 py-3">
            <span class="inline-flex px-2 py-1 rounded-full text-xs font-semibold <%= u.role === 'admin' ? 'bg-indigo-50 text-indigo-700' : 'bg-emerald-50 text-emerald-700' %>">
              <%= u.role %>
            </span>
          </td>
          <td class="px-4 py-3 text-slate-500"><%= u.createdAt.toDateString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/app-end', { sidebar }) %>
