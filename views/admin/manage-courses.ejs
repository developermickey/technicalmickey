<% const sidebar = '../partials/sidebar-admin'; %>
<% const activePath = '/admin/courses'; %>
<% const pageTitle = 'Courses'; %>
<% const pageSubtitle = 'Create, edit, publish and organize course content.'; %>
<%- include('../partials/app-start', { title, sidebar, activePath, pageTitle, pageSubtitle }) %>

<div class="rounded-2xl border border-slate-200/60 bg-slate-50 p-4">
  <div class="flex items-center justify-between mb-3">
    <p class="font-bold">Create new course</p>
    <p class="text-sm text-slate-500">You can add topics/lectures after creating</p>
  </div>
  <form method="post" action="/admin/courses" enctype="multipart/form-data" class="grid md:grid-cols-5 gap-2">
    <input name="title" placeholder="Title" required class="px-3 py-2 border border-slate-200 rounded-xl text-sm bg-white">
    <input name="description" placeholder="Short description" required class="px-3 py-2 border border-slate-200 rounded-xl text-sm bg-white">
    <input name="price" placeholder="Price" type="number" step="0.01" required class="px-3 py-2 border border-slate-200 rounded-xl text-sm bg-white">
    <input name="category" placeholder="Category" class="px-3 py-2 border border-slate-200 rounded-xl text-sm bg-white">
    <input name="thumbnail" type="file" class="px-3 py-2 border border-slate-200 rounded-xl text-sm bg-white">
    <button class="px-4 py-2 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 md:col-span-5">Create course</button>
  </form>
</div>

<div class="grid md:grid-cols-3 gap-4 mt-5">
  <% courses.forEach(course => { %>
    <div class="group rounded-2xl border border-slate-200/60 bg-white overflow-hidden shadow-sm hover:shadow-md transition">
      <div class="h-32 bg-slate-100 overflow-hidden">
        <img src="<%= course.thumbnail || 'https://images.unsplash.com/photo-1489515217757-5fd1be406fef?auto=format&fit=crop&w=800&q=60' %>" class="h-32 w-full object-cover group-hover:scale-[1.02] transition" />
      </div>
      <div class="p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="font-bold tracking-tight truncate"><%= course.title %></h3>
            <p class="text-sm text-slate-500"><%= course.category || 'General' %></p>
          </div>
          <span class="text-sm font-extrabold text-indigo-700">$<%= course.price %></span>
        </div>
        <div class="flex items-center justify-between mt-4">
          <a href="/admin/courses/<%= course._id %>" class="text-sm font-semibold text-indigo-700 hover:underline">Edit</a>
          <form method="post" action="/admin/courses/<%= course._id %>/publish">
            <button class="text-sm font-semibold <%= course.published ? 'text-emerald-700' : 'text-slate-500' %>">
              <%= course.published ? 'Unpublish' : 'Publish' %>
            </button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<%- include('../partials/app-end', { sidebar }) %>
