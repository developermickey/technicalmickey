<div class="bg-white border border-slate-200/60 rounded-2xl shadow-sm overflow-hidden">
  <div class="px-4 py-4 border-b border-slate-100">
    <p class="text-xs uppercase tracking-wide text-slate-500">Student</p>
    <p class="font-semibold text-slate-900 mt-1"><%= user?.name || 'Account' %></p>
  </div>
  <nav class="p-2 text-sm">
    <% const isActive = (p) => (activePath || '').startsWith(p); %>
    <a href="/user/dashboard" class="flex items-center justify-between px-3 py-2 rounded-xl <%= isActive('/user/dashboard') ? 'bg-indigo-50 text-indigo-700' : 'text-slate-700 hover:bg-slate-50' %>">
      <span>Dashboard</span>
    </a>
    <a href="/my-courses" class="flex items-center justify-between px-3 py-2 rounded-xl <%= isActive('/my-courses') ? 'bg-indigo-50 text-indigo-700' : 'text-slate-700 hover:bg-slate-50' %>">
      <span>My Courses</span>
    </a>
    <a href="/courses" class="flex items-center justify-between px-3 py-2 rounded-xl <%= isActive('/courses') ? 'bg-indigo-50 text-indigo-700' : 'text-slate-700 hover:bg-slate-50' %>">
      <span>Browse Courses</span>
    </a>
    <a href="/cart" class="flex items-center justify-between px-3 py-2 rounded-xl <%= isActive('/cart') ? 'bg-indigo-50 text-indigo-700' : 'text-slate-700 hover:bg-slate-50' %>">
      <span>Cart</span>
    </a>
    <a href="/user/profile" class="flex items-center justify-between px-3 py-2 rounded-xl <%= isActive('/user/profile') ? 'bg-indigo-50 text-indigo-700' : 'text-slate-700 hover:bg-slate-50' %>">
      <span>Profile</span>
    </a>
  </nav>
  <div class="p-3 border-t border-slate-100">
    <form action="/auth/logout" method="post">
      <button class="w-full px-3 py-2 rounded-xl bg-slate-900 text-white hover:bg-slate-800 text-sm">Logout</button>
    </form>
  </div>
</div>

