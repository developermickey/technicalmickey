<%- include('head', { title }) %>
<body class="bg-slate-50 text-slate-900">
<%- include('navbar') %>

<div class="max-w-7xl mx-auto px-4 lg:px-6 py-6">
  <div class="grid lg:grid-cols-12 gap-6">
    <% if (typeof sidebar !== 'undefined' && sidebar) { %>
      <aside class="lg:col-span-3">
        <div class="sticky top-20">
          <%- include(sidebar, { activePath: activePath || '' }) %>
        </div>
      </aside>
      <main class="lg:col-span-9">
        <div class="bg-white border border-slate-200/60 rounded-2xl shadow-sm">
          <div class="px-5 py-4 border-b border-slate-100">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h1 class="text-xl md:text-2xl font-bold tracking-tight"><%= pageTitle || title || '' %></h1>
                <% if (pageSubtitle) { %>
                  <p class="text-sm text-slate-500 mt-1"><%= pageSubtitle %></p>
                <% } %>
              </div>
              <% if (typeof headerRight !== 'undefined' && headerRight) { %>
                <div><%- headerRight %></div>
              <% } %>
            </div>
          </div>
          <div class="p-5">
    <% } else { %>
      <main class="lg:col-span-12">
    <% } %>

