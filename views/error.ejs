<%- include('partials/head', { title }) %>
<body class="bg-slate-50">
<%- include('partials/navbar') %>
<div class="max-w-2xl mx-auto px-4 py-20">
  <div class="tm-card p-10 text-center">
    <div class="mx-auto w-14 h-14 rounded-2xl bg-red-50 border border-red-200/60 flex items-center justify-center font-extrabold text-red-700">!</div>
    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900 mt-5"><%= title || 'Error' %></h1>
    <p class="text-slate-600 mt-2"><%= message || 'Something went wrong.' %></p>
    <div class="mt-6 flex gap-2 justify-center">
      <a href="/" class="tm-btn tm-btn-primary" style="padding:12px 16px;">Go home</a>
      <a href="javascript:history.back()" class="tm-btn tm-btn-ghost" style="padding:12px 16px;">Go back</a>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
