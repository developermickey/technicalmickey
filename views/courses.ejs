<%- include('partials/head', { title }) %>
<body class="bg-slate-50">
<%- include('partials/navbar') %>
<main class="max-w-7xl mx-auto px-4 lg:px-6 py-10">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Courses</h1>
      <p class="text-slate-600">Search, filter, and explore all available courses.</p>
    </div>
    <form class="grid sm:grid-cols-3 gap-2 w-full md:w-auto" method="get" action="/courses">
      <input type="text" name="search" value="<%= search %>" placeholder="Search courses" class="px-4 py-2 border border-slate-200 rounded-xl bg-white text-sm">
      <input type="text" name="category" value="<%= category || '' %>" placeholder="Category" class="px-4 py-2 border border-slate-200 rounded-xl bg-white text-sm">
      <button class="px-4 py-2 bg-indigo-600 text-white rounded-xl text-sm font-semibold hover:bg-indigo-700">Filter</button>
    </form>
  </div>
  <div class="grid md:grid-cols-3 gap-6">
    <% courses.forEach(course => { %>
      <div class="group bg-white border border-slate-200/60 rounded-2xl shadow-sm hover:shadow-md transition overflow-hidden flex flex-col">
        <img src="<%= course.thumbnail || 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=800&q=60' %>" class="h-40 w-full object-cover" />
        <div class="p-4 flex flex-col gap-2 flex-1">
          <h3 class="text-base font-extrabold tracking-tight"><%= course.title %></h3>
          <p class="text-sm text-slate-600 line-clamp-2 flex-1"><%= course.description %></p>
          <div class="flex items-center justify-between pt-2">
            <span class="text-indigo-700 font-extrabold">₹<%= course.price %></span>
            <a href="/courses/<%= course._id %>" class="text-sm text-white bg-indigo-600 px-4 py-2 rounded-xl font-semibold hover:bg-indigo-700">View</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
  <div class="flex justify-center gap-2 mt-6 flex-wrap">
    <% for (let i = 1; i <= totalPages; i++) { %>
      <a href="/courses?page=<%= i %>&search=<%= search %>&category=<%= category || '' %>" class="px-3 py-2 border rounded-xl text-sm font-semibold <%= i === currentPage ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50' %>"><%= i %></a>
    <% } %>
  </div>
</main>
<%- include('partials/footer') %>
